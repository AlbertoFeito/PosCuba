# Normaliza finales de línea en el repositorio (LF) y los ajusta al sacar los archivos.
* text=auto

# Código y QML: LF en todas las plataformas
*.cpp text eol=lf
*.h   text eol=lf
*.qml text eol=lf
*.sql text eol=lf
*.qrc text eol=lf
*.md  text eol=lf
CMakeLists.txt text eol=lf
*.in  text eol=lf
*.yml text eol=lf
qmldir text eol=lf

# Scripts de Windows: CRLF (PowerShell y cmd los esperan así)
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binarios
*.png binary
*.ico binary
*.pdf binary
*.db  binary
